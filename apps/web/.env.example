# Environment variables for apps/web.
# Copy to .env.local for local development: cp .env.example .env.local
# Real values are never committed — this file documents names/shapes only.

# --- Foundation (WP1) ---
# Canonical site origin, used for absolute URLs in metadata, sitemap, robots.
# No trailing slash. Local dev default below; in Vercel (Production
# environment) this must be set to https://moraltree.media — see
# DEPLOYMENT.md. moraltreemedia.com and both www. variants redirect to it
# at the application level (next.config.ts), not via this var.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sanity CMS (WP2) ---
# Client/query layer (apps/web/src/lib/sanity) reads these; unset means
# sanityFetch() returns null everywhere and pages fall back to placeholder
# content. Must match apps/studio's SANITY_STUDIO_PROJECT_ID/_DATASET.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Only needed once draft-mode/preview is added (not yet):
# SANITY_API_READ_TOKEN=
# SANITY_REVALIDATE_SECRET=

# Local-only visual-review aid: when true AND Sanity is unconfigured,
# queries.ts substitutes lib/mockContent.ts's stub data so every route
# renders instead of its honest null-state (404/empty/fallback). A
# persistent on-page banner + forced noindex/disallow make it impossible
# to mistake for real content. Never set this in production or CI.
# USE_MOCK_CONTENT=true

# --- Contact form (WP4, components/patterns/ContactForm) ---
# Unset means: no Turnstile widget renders (form still works — honeypot +
# server-side rate limiting still apply) and submissions are rejected with
# a clear "not set up yet" message instead of silently vanishing. Set all
# five to fully activate the form; no code changes needed either way.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
CONTACT_FORM_TO_EMAIL=
CONTACT_FORM_FROM_EMAIL=

# --- Shop (Shopify-hosted storefront, Phase 1 — see lib/shop.ts) ---
# The Moral Tree Media Shopify store's storefront URL. Shopify is the
# system of record for merchandise (catalogue, SKUs, variants, inventory,
# pricing, checkout, orders, fulfilment) — this repo only links out to it
# from primary nav. Unset means the "Shop" nav item is omitted entirely
# rather than falling back to the legacy internal /shop flow below. Set to
# the store's myshopify.com URL for now; swap to a branded domain (e.g.
# https://shop.moraltree.media) later by changing only this value — no
# code changes needed.
NEXT_PUBLIC_SHOP_URL=

# --- Stripe Subscriptions v1 (WP-Stripe) ---
# Internal plan identifiers map to these Stripe Price IDs server-side.
# The browser submits only "MONTHLY" or "ANNUAL" — never a real Price ID.
# Use Stripe TEST MODE keys only; going live is a deliberate, explicit step.
# Create two recurring Prices in the Stripe Dashboard (one monthly, one annual),
# then set their IDs here. The subscribe page shows the live checkout form only
# when BOTH are set.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# --- Free trial configuration (lib/trialConfig.ts) ---
# The browser NEVER supplies the trial duration — the server resolves it
# entirely from the variables below. Maximum is always 30 days (enforced).
#
# Default trial for visitors with no specific campaign/source match.
# 0 or unset = no trial (card charged immediately at checkout).
DEFAULT_TRIAL_DAYS=0
#
# Per-campaign overrides — JSON object mapping campaignId → days (0–30 each).
# Campaigns not listed fall back to DEFAULT_TRIAL_DAYS.
# Example:
#   TRIAL_DAYS_BY_CAMPAIGN='{"dentist-campaign":14,"school-autumn-2026":21,"qr-launch-30":30}'
TRIAL_DAYS_BY_CAMPAIGN=
#
# Per-acquisition-source overrides — JSON object mapping source → days (0–30).
# Example:
#   TRIAL_DAYS_BY_SOURCE='{"qr-poster":30,"partner-email":14}'
TRIAL_DAYS_BY_SOURCE=
#
# FOUNDER DECISIONS REQUIRED (see the STRIPE SUBSCRIPTIONS v1 final report):
#   1. Card required at trial start? YES — current Stripe default with trial_period_days.
#      Card-free trials require a different Stripe setup.
#   2. Auto-convert after trial? YES — Stripe charges the card when trial expires
#      unless the subscription is cancelled first.
#   3. Default non-campaign trial duration? Set DEFAULT_TRIAL_DAYS above.
#
# STRIPE_TRIAL_PERIOD_DAYS is supported for backward compatibility with the
# original v1 deployment but is superseded by DEFAULT_TRIAL_DAYS above.
STRIPE_TRIAL_PERIOD_DAYS=
# Stripe Publishable Key — only needed if you add a client-side Stripe.js
# integration. Stripe-hosted Checkout (the v1 implementation) does not
# require it; only add this if a future feature actually needs it.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Legacy internal shop / Stripe (WP7) — DORMANT, not linked from nav ---
# Superseded by the Shopify integration above (NEXT_PUBLIC_SHOP_URL). Left
# in place but unreachable from primary nav until the Shopify integration
# is proven in production — see CLAUDE.md. Do not configure these to
# bring the old checkout back; if you need real Stripe/Sanity credentials
# for something else, note that intent explicitly, since these vars still
# power /shop, /shop/[slug], /cart, /checkout/* and the Stripe webhook if
# set. Unset means the shop still renders (catalogue, product pages, cart)
# but checkout is rejected with a clear "not set up yet" message rather
# than attempting a real charge — same inert-until-configured contract as
# the contact form above. Use Stripe TEST MODE keys only; going live is a
# deliberate, explicit step the owner takes outside this codebase.
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint (app/api/webhooks/stripe/route.ts),
# from the Stripe Dashboard (or `stripe listen` in local dev). Without it
# the endpoint rejects all events rather than trusting unverified payloads.
STRIPE_WEBHOOK_SECRET=

# Write-authenticated Sanity client (lib/sanity/writeClient.ts). The only
# consumer is the Stripe webhook, which records an `order` document after a
# successful checkout/subscription event. Unset means the webhook still
# verifies and reacts to events but skips the write, logging instead —
# needs a Sanity API token with Editor access, generated once a real
# Sanity project exists.
SANITY_API_WRITE_TOKEN=

# Reuses RESEND_API_KEY above for order confirmation emails. Unset means
# checkout still completes and the order still records — only the
# confirmation email send is skipped (logged, not silently dropped).
SHOP_ORDER_FROM_EMAIL=

# --- Free trial signup (/free30 QR-campaign landing page) ---
# Reuses RESEND_API_KEY / CONTACT_FORM_FROM_EMAIL above to notify a human
# inbox when a parent submits the free-trial signup form. Unset means the
# page still works end-to-end (validation, honeypot, rate limiting) but
# the submission is rejected with an honest "not fully connected yet"
# message instead of silently vanishing. There is no automated trial-
# provisioning/account/audiobook-delivery system behind this yet (see
# CLAUDE.md) — a human still has to action each notified signup by hand.
FREE_TRIAL_TO_EMAIL=

# --- Campaign platform attribution (lib/attribution, Phase 0 — see the
# architecture proposal in PROGRESS.md) ---
# Signs the first-party attribution cookie so a visitor can't forge a
# partner/campaign combination that never occurred. Unset means
# attribution still works (capture + first-touch persistence) but the
# cookie is unsigned — acceptable degraded mode, since no entitlement or
# billing decision reads this value directly. Any long random string;
# rotating it invalidates in-flight (not yet converted) attribution
# cookies, which is a low-stakes, infrequent event.
ATTRIBUTION_COOKIE_SECRET=
