# Environment variables for apps/web.
# Copy to .env.local for local development: cp .env.example .env.local
# Real values are never committed — this file documents names/shapes only.

# --- Foundation (WP1) ---
# Canonical site origin, used for absolute URLs in metadata, sitemap, robots.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sanity CMS (WP2) — not yet wired up ---
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_READ_TOKEN=
# SANITY_REVALIDATE_SECRET=

# --- Forms / spam & rate protection (WP4) — not yet wired up ---
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# CONTACT_FORM_TO_EMAIL=
# CONTACT_FORM_FROM_EMAIL=
# RESEND_API_KEY=
